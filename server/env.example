# Copy to server/.env.server on the PC that will talk to Busy.
# Fill these in after AnyDesk is open on their Busy machine.
# The dashboard never logs into Busy from a browser.

MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=busy_reader
MSSQL_PASSWORD=
# Default company is Suntek Chlorides. The reader also opens these current-year
# files when a request asks for them: 0009 Plasticizer, 0010 NKG, 0012 Madan.
# Chlorides already includes Delhi, Ganjam and Rehla.
MSSQL_DATABASE=BusyComp0007_db12026

# Then, in the Vite build that the plant opens:
# VITE_BUSY_API_URL=http://<this-pc>:3001
# Leave that unset until this server answers GET /api/health with status "connected".

# One-time Busy link service (scripts/busy-link). The secret is created in
# Supabase and is not a Busy password. The anon key is the public dashboard key.
# SUPABASE_URL=https://heiimxqyxthxtnxqozap.supabase.co
# SUPABASE_ANON_KEY=
# BUSY_LINK_SECRET=
